POST https://www.edreams.it/accommodation-funnel-bff/service/graphql
{"query":"\n  query accommodationDetails(\n    $accommodationDetailsRequest: AccommodationDetailsRequest!\n  )  {\n    accommodationDetails(\n      accommodationDetailsRequest: $accommodationDetailsRequest\n    ) {\n      accommodationDetail {\n        accommodationDealInformation {\n          name\n          cityName\n          neighbourhood\n          address\n          description\n          chain\n          type\n          coordinates {\n            latitude\n            longitude\n          }\n          category\n          mainAccommodationImage {\n            url\n            thumbnailUrl\n            type\n          }\n        }\n        images {\n          quality\n          sources {\n            url\n            thumbnailUrl\n            type\n          }\n        }\n        facilityGroups {\n          code\n          description\n          facilities {\n            code\n            description\n          }\n        }\n        accommodationFacilities\n        hotelType\n        distanceFromCityCenter\n        checkInPolicy\n        checkOutPolicy\n        policies {\n          type\n          content\n        }\n        country\n        countryName\n        postalCode\n        accommodationReview {\n          providerCode\n          rating\n          totalReviews\n          providerReviewId\n        }\n        favorite\n        propertySnippets {\n          category\n          title\n          text\n        }\n      }\n    }\n  }\n","variables":{"accommodationDetailsRequest":{"contentKey":"T0MjMzM1MTY1Mg"}},"operationName":"accommodationDetails"}