{"operationName":"LegalNotices","variables":{"pageContext":"RESULT_LIST","markupLanguage":"HTML","isMantraPaymentEnabled":true,"isRecommendedSortedEnabled":false},"query":"query LegalNotices($pageContext: LegalNoticePageContext!, $markupLanguage: MarkupLanguage, $isMantraPaymentEnabled: Boolean, $isRecommendedSortedEnabled: Boolean, $hotelId: String) {\n  legalNotices(\n    pageContext: $pageContext\n    markupLanguage: $markupLanguage\n    isMantraPaymentEnabled: $isMantraPaymentEnabled\n    isRecommendedSortedEnabled: $isRecommendedSortedEnabled\n    hotelId: $hotelId\n  )\n}"}