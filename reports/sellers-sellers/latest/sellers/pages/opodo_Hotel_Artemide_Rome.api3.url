POST https://www.opodo.it/frontend-api/service/graphql
{"query":"\n  query accommodationDealsV2($request: AccommodationDealRequest!) {\n    accommodationDealsV2(request: $request) {\n      deals {\n        checkInDate\n        checkOutDate\n        discount\n        dedupId\n        destination {\n          id\n          name\n          iata\n        }\n        price {\n          amount\n          currency\n        }\n        priceNonPrime {\n          amount\n          currency\n        }\n        discountAbsolute {\n          amount\n          currency\n        }\n        accommodationInfo {\n          accommodationDetail {\n            accommodationDealInformation {\n              mainAccommodationImage {\n                url\n              }\n              cityName\n              name\n              cancellationFree\n              stars\n            }\n            accommodationReview {\n              rating\n              totalReviews\n            }\n          }\n        }\n      }\n      dealsId\n    }\n  }\n","variables":{"request":{"maxResults":10,"searchPriority":"UPCOMING_TRIP"}},"operationName":"accommodationDealsV2"}