POST https://www.simplebooking.it/graphql/ibe2/graphql?opname=HotelCalendarDatesIO&hid=8930
{"operationName":"HotelCalendarDatesIO","variables":{"hotelId":"8930","from":"2026-11-23","to":"2027-01-28"},"extensions":{"clientLibrary":{"name":"@apollo/client","version":"4.1.9"}},"query":"query HotelCalendarDatesIO($hotelId: ID!, $from: Date!, $to: Date!) {\n  hotel(id: $hotelId) {\n    id\n    calendarDates(from: $from, to: $to) {\n      id\n      date\n      availableForCheckIn\n      availableForCheckOut\n      availableForNightStay\n      closeToCheckIn\n      closeToCheckOut\n      maximumStay\n      minimumStay\n      __typename\n    }\n    __typename\n  }\n}"}