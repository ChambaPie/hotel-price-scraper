agentSms":false},"corporateContact":{"sendEmail":false,"sendSms":false,"name":"null null"},"corporateConfiguration":{},"extensionName":"Corporate"},{"extensionName":"CookieExtension"},{"configuration":{"homeButtonURL":"https://www.hotelplaza.hr/en/","isPhone":false,"isTablet":false},"extensionName":"Mobile"}],"id":"1c3799e65b6290dcfcbcb08211b6e5ee","state":"ListRooms","billingContact":{},"hotel":{"hotelId":4032,"guideId":821,"name":"Hotel Plaža Omiš","timeZone":"Europe/Zagreb","addressId":3294,"address":null,"currency":"EUR","bookitLevel":2,"hotelType":"Hotel","hotelStandard":4,"numberOfRooms":90,"numberOfSuites":0,"softguidesServiceLevel":3,"creationDate":"2021-02-16","priority":"D","legalName":"Andro Internacional d.o.o.","shortDescription":"<p>Hotel Plaža Omiš****: Unique riverside & seaside spot by a sandy beach. Elegant rooms, \"Pirate Tavern\" dining, and \"Beauty & Spa\" wellness. Your perfect base to explore Omiš and relax.</p>","bookingEmail":"sales@hotelplaza.hr","voucherEmail":"","maxMonthBookAhead":24,"maxStayNights":365,"minHoursAhead":0,"earliestCheckin":"2 PM","latestCheckout":"12 AM","prioritySort":0,"showCustomerContact":false,"minSuggestPrice":0,"level2Page":"hotel_plaza_Omis.html","vatNo":"67025642845","contactName":"Katia Barac","logo":"","manRequestStatus":0,"manRequestHours":0,"vatIncludedInPrice":true,"vatPercentage":13,"hasCityTax":false,"cityTaxIncludedInPrice":false,"comment":"<p><strong>Welcome to Hotel Plaža Omiš****</strong></p>\r\n<p>Hotel Plaža Omiš**** is situated in an attractive location <strong>near the sea and the river</strong>, right next to the town’s main sandy beach and with the old town core near at hand.</p>\r\n<p>The hotel offers accommodation in elegantly equipped rooms, high-quality gastronomic offer in the pleasant ambient of <strong>restaurants</strong> Plaža and Pirate Tavern and City Cafe coffee house, along with relaxing moments in the <strong>wellnes & spa center</strong> Beauty & Spa Plaža. Let our hotel be the starting point for new experiences and exploring all the beauties of Omiš.</p>\r\n<p>We pay a lot of attention to small details both in the rooms and the whole facility. We want the guests to feel comfortable and make Hotel Plaža Omiš their first choice whether they come for business purposes, tourist vacation or a romantic getaway.</p>","cancellationPolicy":"<p>Cancellation and prepayment policies vary according to room type. Please check what conditions apply to your preferred room.</p>\r\n<p><strong>Check-in:</strong> 2 pm</p>\r\n<p><strong>Check-out:</strong> 12 noon</p>","corporateCancellationPolicy":"","voucherPolicy":"","rewardPolicy":"","commission":0,"howToGet":"<p><strong>By car:</strong><br />From direction Zagreb and Rijeka – via A1 motorway until the exit in Dugopolje, direction Split via D8 state road or exit in Blato na Cetini, direction Split - Omiš via D70 state road (not recommended for campers and other larger vehicles) until reaching the D8 state road. From direction Dubrovnik – via A1 motorway until the exit in Šestanovac, direction Split - Omiš via D39 state road until reaching the D8 state road.</p>\r\n<p>Information for drivers: Hrvatski autoklub.</p>\r\n<p><strong>By boat:</strong> <br />Seek information about ferry lines to our nearest ferry port in Split on the website: www.jadrolinija.hr .</p>\r\n<p><strong>By plane:</strong> <br />Reach Split airport and then take the transfer or a bus to Omiš or Duće.</p>\r\n<p><strong>By bus:</strong> <br />By regular bus lines from Rijeka, Zagreb and Dubrovnik.</p>","deposit":0,"defaultAdults":2,"defaultChildren":0,"defaultRooms":1,"translations":{"hr":{"hotelId":4032,"language":"hr","hotelType":"","howToGet":"<p><strong>Automobilom:</strong> Iz smjera Rijeke i Zagreba &ndash; autocestom A1 do izlaza Dugopolje, u smjeru Split, državnom cestom D-8 ili na izlaz Blato na Cetini u smjeru Split &ndash; Omi&scaron;, državnom cestom D-70 (nije preporučeno za kampere i druga veća vozila)  prema državnoj cesti D-8. Iz smjera Dubrovnika &ndash;  autocestom A1 na izlaz &Scaron;estanovac, u smjeru Split &ndash; Omi&scaron; državnom cestom D-39 prema državnoj cesti D-8.</p>\r\n<p>Informacije za vozače: Hrvatski autoklub</p>\r\n<p><strong>Brodom:</strong> Na internetskoj stranici www.jadrolinija.hr potražite informacije o trajektnim linijama prema najbližoj trajektnoj luci Split.</p>\r\n<p><strong>Zrakoplovom:</strong> Do najbliže zračne luke Split, a zatim transferom ili autobusom do Omi&scaron;a ili Duća.</p>\r\n<p><strong>Autobusom: </strong> Redovnim autobusnim linijama iz Rijeke, Zagreba i Dubrovnika.</p>","comment":"<p><strong>Dobrodo&scaron;li u Hotel Plaža Omi&scaron;**** </strong></p>\r\n<p>Hotel Plaža Omi&scaron; ****  nalazi se na atraktivnoj lokaciji uz more i rijeku, uz glavnu gradsku pje&scaron;čanu plažu i u neposrednoj blizini stare gradske jezgre.</p>\r\n<p>Hotel nudi smje&scaron;taj u elegantno opremljenim sobama, kvalitetnu gastro ponudu u ugodnim ambijentima  <strong>restorana</strong> &bdquo;Plaža&ldquo; i  &bdquo;Gusarska konoba&ldquo; te caffe bara &bdquo;Gradska kavana&ldquo;, kao i opu&scaron;tajuće trenutke u <strong>wellness &amp; spa centru</strong> &bdquo;Beauty &amp; Spa Plaža&ldquo;. Neka na&scaron; hotel bude početna točka za nova iskustva i istraživanje ljepota Omi&scaron;a.</p>\r\n<p>Puno pažnje posvećujemo malim detaljima, kako u sobama tako i cijelom objektu. Želimo da se gosti osjećaju udobno te da im Hotel Plaža Omi&scaron; postane prvi odabir bilo da su u pitanju poslovne obveze, turistički odmor ili romantični vikend.</p>","cancellationPolicy":"<p>Pravila otkazivanja i plaćanja unaprijed razlikuju se ovisno o vrsti sobe. Molimo provjerite koji se uvjeti primjenjuju na željenu sobu.</p>\r\n<p><strong>Check-in:</strong>&nbsp;14:00</p>\r\n<p><strong>Check-out:&nbsp;</strong>12:00</p>","corporateCancellationPolicy":"","shortDescription":"<p>Hotel Plaža Omi&scaron;****: Na u&scaron;ću rijeke uz pje&scaron;čanu plažu. Elegantne sobe, wellness &