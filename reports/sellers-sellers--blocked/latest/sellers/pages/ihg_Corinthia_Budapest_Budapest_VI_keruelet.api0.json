.ihg.com/is/image/ihg/intercontinental-budapest-4376768404-16x5","aspectHeight":"5","aspectWidth":"16"}]},{"type":"primaryGroupsAndMeetingsPhoto","primary":null,"caption":null,"originalUrl":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-11432869619-original","formats":[{"url":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-11432869619-16x5","aspectHeight":"5","aspectWidth":"16"},{"url":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-11432869619-4x3","aspectHeight":"3","aspectWidth":"4"}]},{"type":"primaryRoomPhoto","primary":null,"caption":null,"originalUrl":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-7717602553-original","formats":[{"url":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-7717602553-16x5","aspectHeight":"5","aspectWidth":"16"},{"url":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-7717602553-4x3","aspectHeight":"3","aspectWidth":"4"}]},{"type":"primaryDiningPhoto","primary":null,"caption":null,"originalUrl":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-11432869591-original","formats":[{"url":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-11432869591-16x5","aspectHeight":"5","aspectWidth":"16"},{"url":"https://digital.ihg.com/is/image/ihg/intercontinental-budapest-11432869591-4x3","aspectHeight":"3","aspectWidth":"4"}]}]}},"foodAndBeverage":null,"restaurant":{"onSiteRestaurantsCount":2},"tax":{"taxAndFeeDetail":"","serviceCharge":null}},{"hotelCode":"BUDKM","callCenter":{"phoneNumber":"06800 80321"},"address":{"street1":"Bem József tér 3.","street2":null,"street3":null,"city":"Budapest","zip":"1027","state":null,"country":{"name":"Hungary","code":"HU"},"checkInAddress":null},"location":null,"distanceFrom":{"kilometers":2.46,"miles":1.53},"marketing":{"optOutDateWeb":null,"optInDateWeb":null,"marketingText":{"welcomeMessage":"<p>The urban cool kid on the block, seated on the Buda banks of the Danube, Kimpton BEM takes residence in Budapest’s distinctively welcoming neighborhood. Nestled in the heart of history, our hotel is a stone's throw from the Castle District, creating a timeless journey through Budapest's regal past with threads of Hungarian history engulfed in lush grandeur. The city's legendary Turkish baths, a testament to centuries of leisure and luxury, are close by and not to be missed.</p>\n<p>The transformation of this long forgotten 19th-century building has been meticulously created by the renowned Marcel Wanders. Breathing a new life into this historical, grade 2 listed mansion. Embracing the locality, the charm and the history to create a destination that echoes a forgotten era. Striking and stylish, our design originates from the history of the capital, each space a canvas painting Hungary's vibrant soul. Our rooms offer a front-row seat to the city's ever-changing panorama, connecting people with the place, past with present, traditional with modern. Authentically crafted for the ultimate luxury lifestyle hideaway in this bustling capital.</p>"}},"brandInfo":{"SPBrandName":null,"brandCode":"KIKI","brandName":"Kimpton","chainCode":"KI","futureBrandInfo":null,"spTransitionalBrandIdentifier":null},"greenEngage":{"certificationPrograms":{"certifiedByGloballyRecognizedSustainableProgram":true,"environmentalCertificationProgram":{"listItem":["LEED Gold","LEED O+M"]}},"lowCarbon":{"lowCarbonHotelDescription":"A first of its kind in our industry, IHG’s Low Carbon Pioneer programme brings together energy efficient hotels that have no fossil fuels combusted on-site (with the exception of backup generators), and are backed by renewable energy.\n\nHotels participating as Low Carbon Hotels must: \n1. Demonstrate energy efficiency Improvements over global benchmarks \n2. Have zero fossil fuels combusted on site (with the exception of backup generators) \n3. Be backed by renewable energy \n4. Have a globally recognized sustainability certification (within 12 months of opening for newly opened hotels)\n\nThis hotel has solar PV panels to generate renewable energy, an all-electric kitchen with induction technology, heat pumps for hot water and space heating, and a range of additional measures to minimise energy use across the hotel.","isLowCarbonHotel":"Yes"},"lowCarbonReady":{"lowCarbonReadyHotelDescription":null,"isLowCarbonReadyHotel":"No"}},"room":null,"badges":[{"name":"Hosted Evening Wine Hour for all Kimpton Guests","id":"WINE_HOUR"},{"name":"IHG Green Engage™ Level 0","id":"GREEN_ENGAGE"},{"name":"Free Internet","id":"FREE_INTERNET"},{"name":"Pet Friendly","id":"PET_FRIENDLY"},{"name":"中国客人专享 “洲道”服务","id":"CHINA_READY"}],"facilities":[{"name":"Wireless Internet","id":"WIRELESS_INTERNET"},{"name":"Pets Allowed","id":"PETS_ALLOWED"},{"name":"Health/Fitness Center","id":"HEALTH_FITNESS_CENTER"},{"name":"EV Charging","id":"EV_CHARGING"},{"name":"In hotel restaurants","id":"IN_HOTEL_RESTAURANTS"},{"name":"Suites","id":"SUITES"},{"name":"Sustainable Practices","id":"SUSTAINABLE_PRACTICES"}],"parking":{"complimentaryDailySelfParking":false,"parkingDescription":"Onsite secured self or valet parking with in and out privileges at 35EUR.\n2 spaces for disabled.\nNo trailers, trucks, no extended parking.\nE charging available.","carParkingAvailable":true,"valetParkingAvailable":true},"policies":{"pet":{"petsAllowed":true,"guideDogsOrServiceAnimalsAllowed":true,"description":"We welcome your furry, scaly or feathery family members no matter the size, as long as they fit in our elevator."}},"stripes":null,"renovationAlertsList":null,"profile":{"name":"BEM Budapest","webNonBrandedHotelLogo":{"url":"https://digital.ihg.com/is/content/ihg/kimpton-budapest-9550435319-original?fmt=svg"},"seoCity":"bem-budapest-hungary","nonIhgCrsUrl":null,"independentNonIHGWebsiteURL":"http:\\\\www.kimptonbembudapest.com","hotelLogo":null,"averageReview":4.777777777777778,"tpiLevel2Violator":null,"primaryImageUrl":{"originalUrl":"https://digital.ihg.com/is/image/ihg