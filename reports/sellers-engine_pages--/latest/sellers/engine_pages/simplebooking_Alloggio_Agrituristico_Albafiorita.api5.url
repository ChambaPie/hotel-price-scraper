POST https://www.simplebooking.it/graphql/ibe2/graphql?opname=StandardAvailabilitySearchRateMatchIO&hid=8930
{"operationName":"StandardAvailabilitySearchRateMatchIO","variables":{"currencyCode":"EUR","standardAvailabilitySearchResultGuid":"b3909d81-b22a-49c9-b00e-9c272c1009e9"},"extensions":{"clientLibrary":{"name":"@apollo/client","version":"4.1.9"}},"query":"query StandardAvailabilitySearchRateMatchIO($currencyCode: ID!, $standardAvailabilitySearchResultGuid: ID!) {\n  rateMatch: calculatedRateMatch(\n    currencyCode: $currencyCode\n    standardAvailabilitySearchResultGuid: $standardAvailabilitySearchResultGuid\n  ) {\n    guid\n    ourRate {\n      ...StandardAvailabilitySearchRateMatchIOPrice\n      __typename\n    }\n    currency {\n      code\n      inEUR\n      __typename\n    }\n    competitorsRates {\n      competitor\n      price {\n        ...StandardAvailabilitySearchRateMatchIOPrice\n        __typename\n      }\n      __typename\n    }\n    shouldDisplayCompetitors\n    options {\n      signature\n      price {\n        ...StandardAvailabilitySearchRateMatchIOPrice\n        __typename\n      }\n      basePrice {\n        ...StandardAvailabilitySearchRateMatchIOPrice\n        __typename\n      }\n      dailyPrice {\n        ...StandardAvailabilitySearchIODailyPrice\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment StandardAvailabilitySearchRateMatchIOPrice on Price {\n  amount\n  amountIncludesTaxes\n  currencyCode\n  taxesPercent\n  __typename\n}\n\nfragment StandardAvailabilitySearchIODailyPrice on RoomOptionDailyPrice {\n  averagePricePerNight {\n    ...StandardAvailabilitySearchIOPrice\n    __typename\n  }\n  rates {\n    date\n    price {\n      ...StandardAvailabilitySearchIOPrice\n      __typename\n    }\n    basePrice {\n      ...StandardAvailabilitySearchIOPrice\n      __typename\n    }\n    __typename\n  }\n  __typename\n}\n\nfragment StandardAvailabilitySearchIOPrice on Price {\n  amount\n  amountIncludesTaxes\n  currencyCode\n  taxesPercent\n  __typename\n}"}