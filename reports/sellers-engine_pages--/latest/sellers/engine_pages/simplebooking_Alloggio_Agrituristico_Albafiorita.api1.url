POST https://www.simplebooking.it/graphql/ibe2/graphql?opname=HotelBaseDataIO&hid=8930
{"operationName":"HotelBaseDataIO","variables":{"hotelId":"8930"},"extensions":{"clientLibrary":{"name":"@apollo/client","version":"4.1.9"}},"query":"query HotelBaseDataIO($hotelId: ID!) {\n  hotel(id: $hotelId) {\n    id\n    bankTransferCoordinates {\n      accountNumber\n      bic\n      id\n      recipientName\n      __typename\n    }\n    countryId\n    currency {\n      name\n      code\n      symbol\n      decimalsToDisplay\n      inEUR\n      isTopCurrency\n      __typename\n    }\n    defaultLanguage {\n      code\n      __typename\n    }\n    stars\n    logoURL\n    luxury\n    emailAddress\n    phoneNumber\n    coordinates {\n      latitude\n      longitude\n      __typename\n    }\n    medias {\n      bigUrl: url(size: BIG)\n      mediumUrl: url(size: MEDIUM)\n      smallUrl: url(size: SMALL)\n      ... on MediaVideo {\n        bigThumbnailUrl: thumbnailUrl(size: BIG)\n        mediumThumbnailUrl: thumbnailUrl(size: MEDIUM)\n        smallThumbnailUrl: thumbnailUrl(size: SMALL)\n        videoSource\n        __typename\n      }\n      __typename\n    }\n    review {\n      id\n      reviews\n      score\n      __typename\n    }\n    settings {\n      acceptedCreditCardTypes {\n        brand\n        logoURL\n        __typename\n      }\n      analyticsMeasuring {\n        duetto {\n          ...HotelBaseDataAnalyticsConfigurationSettings\n          __typename\n        }\n        facebook {\n          ...HotelBaseDataAnalyticsConfigurationSettings\n          __typename\n        }\n        googleAnalytics {\n          ...HotelBaseDataAnalyticsConfigurationSettings\n          __typename\n        }\n        googleRemarketing {\n          ...HotelBaseDataAnalyticsConfigurationSettings\n          __typename\n        }\n        piwik {\n          ...HotelBaseDataAnalyticsConfigurationSettings\n          __typename\n        }\n        pageViewMapping {\n          ...HotelBaseDataAnalyticPageViewMapping\n          __typename\n        }\n        remarketingMapping {\n          ...HotelBaseDataAnalyticsRemarketingMapping\n          __typename\n        }\n        __typename\n      }\n      applyMaximumStayOnCheckInOnly\n      applyMinimumStayOnCheckInOnly\n      applyRoomsOrderToResults\n      backgroundColor\n      backgroundImageURL\n      childMaxAge\n      childMinAge\n      childrenAreBookable\n      displayCouponField\n      enchantingMessagesAreEnabled\n      headerFooterBackgroundColor\n      holipayHotelId\n      id\n      includeServicesInQuoteProposalTotal\n      languages {\n        code\n        name\n        __typename\n      }\n      mapType\n      mapZoom\n      maxBookableRooms\n      maxPersonsPerRoom\n      minishopIsEnabled\n      priceRounding {\n        direction\n        type\n        value\n        __typename\n      }\n      pricesIncludeTaxes\n      primaryColor\n      rateMatchDiscountPercentageDisplayThreshold\n      rateMatchIsEnabled\n      realtimeConfiguration {\n        interactiveBookingUserHubUrl\n        __typename\n      }\n      roundedLayout\n      sameDayBookingTimeLimit\n      secondaryColor\n      showAvailabilityRoomsTable\n      showBestRateGuaranteed\n      showDiscountLabel\n      showPricePerNight\n      skipIsraelCountryWarningFinalStep\n      timezone\n      useAdvancedCalendar\n      useHtmlRoomDescription\n      useMultipleOfMinimumStay\n      useMultiRoomSelection\n      userReEngagementEnabled\n      enableVoucherInput\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment HotelBaseDataAnalyticsConfigurationSettings on AnalyticsConfiguration {\n  measuramentId\n  script\n  version\n  __typename\n}\n\nfragment HotelBaseDataAnalyticPageViewMapping on AnalyticPageViewMapping {\n  availability\n  customerStepOne\n  customerStepTwo\n  noResult\n  opened\n  packageSummary\n  personalAreaLogin\n  profile\n  reservationDetail\n  reservationsList\n  room\n  roomSummary\n  search\n  sentAvailability\n  services\n  __typename\n}\n\nfragment HotelBaseDataAnalyticsRemarketingMapping on AnalyticsRemarketingMapping {\n  conversion\n  conversionIntent\n  home\n  offerDetail\n  other\n  searchResults\n  __typename\n}"}