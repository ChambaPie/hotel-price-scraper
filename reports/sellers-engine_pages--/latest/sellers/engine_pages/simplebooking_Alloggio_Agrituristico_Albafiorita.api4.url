POST https://www.simplebooking.it/graphql/ibe2/graphql?opname=StandardAvailabilitySearchIO&hid=8930
{"operationName":"StandardAvailabilitySearchIO","variables":{"hotelId":"8930","languageCode":"EN","timezoneMinutesOffset":0,"query":{"allocations":[{"adults":2,"children":[]}],"checkIn":"2026-12-14","checkOut":"2026-12-15","coupon":null,"isAlternative":false,"languageCode":"EN"}},"extensions":{"clientLibrary":{"name":"@apollo/client","version":"4.1.9"}},"query":"query StandardAvailabilitySearchIO($hotelId: ID!, $query: StandardAvailabilitySearchQueryInput!, $languageCode: ID!, $timezoneMinutesOffset: Int!) {\n  hotel(id: $hotelId) {\n    id\n    result: standardAvailabilitySearch(query: $query) {\n      guid\n      rateMatchEnabled\n      noAvailabilityRoomsHTML(languageCode: $languageCode)\n      coupon {\n        affiliatedEntity {\n          ...StandardAvailabilitySearchIOAffiliatedEntity\n          __typename\n        }\n        recognized\n        unrecognizedMessage(\n          languageCode: $languageCode\n          timezoneMinutesOffset: $timezoneMinutesOffset\n        )\n        __typename\n      }\n      options {\n        signature\n        affiliatedEntity {\n          ...StandardAvailabilitySearchIOAffiliatedEntity\n          __typename\n        }\n        allocation {\n          adults\n          children\n          __typename\n        }\n        isSecret\n        isLoayltyClubOffer\n        isExclusive\n        availableQuantity\n        forNightsLabel(languageCode: $languageCode)\n        roomTypeAvailableQuantity\n        roomTypeAvailableQuantityLabel(languageCode: $languageCode)\n        extraGuestsLabel(languageCode: $languageCode)\n        price {\n          ...StandardAvailabilitySearchIOPrice\n          __typename\n        }\n        basePrice {\n          ...StandardAvailabilitySearchIOPrice\n          __typename\n        }\n        dailyPrice {\n          ...StandardAvailabilitySearchIODailyPrice\n          __typename\n        }\n        cancellationPolicy {\n          id\n          __typename\n        }\n        mealPlan {\n          id\n          __typename\n        }\n        offer {\n          id\n          __typename\n        }\n        ratePlan {\n          id\n          __typename\n        }\n        room {\n          id\n          parentId\n          __typename\n        }\n        __typename\n      }\n      optionsMatchRequestedAllocation\n      __typename\n    }\n    __typename\n  }\n}\n\nfragment StandardAvailabilitySearchIOAffiliatedEntity on AffiliatedEntity {\n  __typename\n  ... on AffiliatedAgency {\n    id\n    name\n    __typename\n  }\n  ... on AffiliatedCompany {\n    id\n    name\n    __typename\n  }\n}\n\nfragment StandardAvailabilitySearchIOPrice on Price {\n  amount\n  amountIncludesTaxes\n  currencyCode\n  taxesPercent\n  __typename\n}\n\nfragment StandardAvailabilitySearchIODailyPrice on RoomOptionDailyPrice {\n  averagePricePerNight {\n    ...StandardAvailabilitySearchIOPrice\n    __typename\n  }\n  rates {\n    date\n    price {\n      ...StandardAvailabilitySearchIOPrice\n      __typename\n    }\n    basePrice {\n      ...StandardAvailabilitySearchIOPrice\n      __typename\n    }\n    __typename\n  }\n  __typename\n}"}