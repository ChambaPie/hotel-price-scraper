POST https://www.simplebooking.it/graphql/ibe2/graphql?opname=HotelEnchantingMessagesIO&hid=8930
{"operationName":"HotelEnchantingMessagesIO","variables":{"hotelId":"8930","query":{"allocations":[{"adults":2,"children":[]}],"checkIn":"2026-12-14","checkOut":"2026-12-15","coupon":null,"languageCode":"EN","isAlternative":null}},"extensions":{"clientLibrary":{"name":"@apollo/client","version":"4.1.9"}},"query":"query HotelEnchantingMessagesIO($hotelId: ID!, $query: StandardAvailabilitySearchQueryInput!) {\n  hotel(id: $hotelId) {\n    id\n    enchantingMessages(query: $query) {\n      id\n      title\n      name\n      text\n      description\n      medias {\n        bigUrl: url(size: BIG)\n        mediumUrl: url(size: MEDIUM)\n        smallUrl: url(size: SMALL)\n        ... on MediaVideo {\n          bigThumbnailUrl: thumbnailUrl(size: BIG)\n          mediumThumbnailUrl: thumbnailUrl(size: MEDIUM)\n          smallThumbnailUrl: thumbnailUrl(size: SMALL)\n          videoSource\n          __typename\n        }\n        __typename\n      }\n      __typename\n    }\n    __typename\n  }\n}"}